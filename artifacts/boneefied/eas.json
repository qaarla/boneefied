{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "node": "22.16.0",
      "pnpm": "10.26.1",
      "android": {
        "image": "sdk-57",
        "buildType": "apk"
      },
      "ios": {
        "image": "sdk-57",
        "simulator": false
      }
    },
    "production": {
      "extends": "preview",
      "distribution": "store",
      "developmentClient": false,
      "credentialsSource": "remote",
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}